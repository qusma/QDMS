# Copy to .env and fill in. .env is gitignored.
POSTGRES_PASSWORD=
# host port for Postgres (bound to loopback only)
POSTGRES_PORT=5432
QDMS_API_KEY=

TIINGO_API_KEY=

# IB Gateway/TWS, if running on the Docker host
IB_ENABLED=false
IB_HOST=host.docker.internal
IB_PORT=4002

# update job reports (optional)
JOB_REPORT_EMAIL=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# time zone of the server process: update job schedules (e.g. "daily at 18:00") run in this zone
TZ=UTC
