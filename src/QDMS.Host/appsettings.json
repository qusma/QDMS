{
  "ConnectionStrings": {
    "Qdms": "Host=localhost;Port=5432;Database=qdms;Username=qdms;Password=qdms",
    "QdmsData": null
  },
  "Qdms": {
    "apiKey": null,
    "httpPort": 5559,
    "hDBPort": 5555,
    "rtDBPubPort": 5556,
    "rtDBReqPort": 5557,

    "enableInteractiveBrokers": false,
    "ibClientHost": "127.0.0.1",
    "ibClientPort": 4002,
    "histClientIBID": 99,
    "rtdClientIBID": 98,

    "tiingoApiKey": null,
    "EconomicReleaseDefaultDatasource": null,

    "updateJobReportErrors": true,
    "updateJobReportOutliers": true,
    "updateJobReportNoData": true,
    "updateJobTimeouts": true,
    "updateJobTimeout": 5,
    "updateJobEmail": null,
    "updateJobEmailHost": null,
    "updateJobEmailUsername": null,
    "updateJobEmailPassword": null,
    "updateJobEmailPort": 587,
    "updateJobEmailSender": null
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "console": {
        "type": "ColoredConsole",
        "layout": "${longdate} ${level:uppercase=true:padding=-5} ${logger:shortName=true}: ${message}${onexception:inner= ${exception:format=tostring}}"
      },
      "file": {
        "type": "File",
        "fileName": "${basedir}/logs/qdms-${shortdate}.log",
        "maxArchiveFiles": 30,
        "layout": "${longdate} ${level:uppercase=true:padding=-5} ${logger}: ${message}${onexception:inner= ${exception:format=tostring}}"
      }
    },
    "rules": [
      { "logger": "Microsoft.EntityFrameworkCore.Database.Command", "maxLevel": "Error", "final": true },
      { "logger": "Microsoft.EntityFrameworkCore.*", "maxLevel": "Info", "final": true },
      { "logger": "Microsoft.AspNetCore.*", "maxLevel": "Info", "final": true },
      { "logger": "Quartz.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "console,file" }
    ]
  }
}
