<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.1 so that net5-era consumers (QTS; netstandard2.1 is the floor because of NetMQ) can still use the client -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- "QDMS", not "QDMS.Common": published clients (0.10.x) serialize LINQ predicates with "QDMS.Instrument, QDMS" type names -->
    <AssemblyName>QDMS</AssemblyName>
    <RootNamespace>QDMS</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetaLinqStandard" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="protobuf-net" />
    <PackageReference Include="QLNet" />
    <PackageReference Include="System.ComponentModel.Annotations" />
  </ItemGroup>

</Project>
